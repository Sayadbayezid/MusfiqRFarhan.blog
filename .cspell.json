{
  "version": "0.2",
  "allowCompoundWords": true,
  "overrides": [
    {
      "filename": "**/*",
      "enabled": false
    },
    {
      "filename": "**/*.md",
      "enabled": true
    }
  ],
  "flagWords": [
    "alot",
    "hte",
    "langauge",
    "reccommend",
    "seperate",
    "teh"
